{
  "name": "module-manager",
  "version": "1.1.0",
  "description": "Unified module system for pi — manages extensions and skills from a shared vault",
  "type": "module",
  "keywords": [
    "pi-package",
    "module-manager",
    "extensions",
    "skills"
  ],
  "license": "MIT",
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "validate": "tsc --noEmit --skipLibCheck"
  },
  "dependencies": {
    "typebox": "^1.1.24"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "^0.80.0"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.80.10",
    "@earendil-works/pi-coding-agent": "^0.80.0",
    "@types/node": "^20.10.0",
    "typescript": "^5.3.0",
    "vitest": "^4.1.10"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ],
    "skills": [
      "./skills"
    ]
  }
}
